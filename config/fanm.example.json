{
  "provider": {
    "name": "deepseek",
    "model": "deepseek-v4-pro"
  },
  "budget": {
    "monthlyUsd": 12,
    "perWorkUsd": 0.5
  },
  "generation": {
    "planMaxTokens": 4000,
    "generateMaxTokens": 32000,
    "reasoningEffort": "high"
  },
  "production": {
    "attemptsPerDay": 6,
    "maxRepairs": 2
  },
  "publish": {
    "target": "cloudflare",
    "wranglerConfig": "wrangler.jsonc",
    "apiTokenEnv": "CLOUDFLARE_API_TOKEN",
    "accountIdEnv": "CLOUDFLARE_ACCOUNT_ID",
    "everyHours": 6,
    "siteUrl": "https://fanm.oyabanare.com"
  }
}
