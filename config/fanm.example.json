{
  "provider": {
    "name": "deepseek",
    "model": "deepseek-v4-pro",
    "apiKeyEnv": "DEEPSEEK_API_KEY",
    "baseUrl": "https://api.deepseek.com"
  },
  "budget": {
    "monthlyUsd": 12,
    "perWorkUsd": 0.5
  },
  "generation": {
    "planMaxTokens": 4000,
    "generateMaxTokens": 32000,
    "reasoningEffort": "high"
  },
  "production": {
    "attemptsPerDay": 4,
    "maxRepairs": 2
  }
}
